{
  "name": "agents-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build --workspaces --if-present",
    "build:apps": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "tsx scripts/final_agentic_proof.ts",
    "verify:providers": "tsx scripts/verify_provider_consistency.ts",
    "verify:providers:semantic": "tsx scripts/verify_provider_semantic_consistency.ts",
    "verify:learning-trend": "tsx scripts/verify_learning_effect_trend.ts",
    "verify:chat-flow": "tsx scripts/verify_chat_entrypoint_flow.ts",
    "bootstrap:learning-trend": "tsx scripts/bootstrap_learning_trend_evidence.ts",
    "generate:real-telemetry": "tsx scripts/generate_real_telemetry_dataset.ts",
    "test:scenarios": "jest --runInBand src/runtime/__tests__/dynamic_pipeline_executor.test.ts src/runtime/__tests__/run_ledger.test.ts src/runtime/__tests__/agent_workbench_scheduler.test.ts",
    "test:final-validation-remediation": "jest --runInBand src/runtime/__tests__/final_system_validation_remediation.test.ts",
    "proof": "tsx scripts/final_agentic_proof.ts",
    "git:audit": "bash scripts/git/worktree_audit.sh",
    "git:audit:strict": "bash scripts/git/worktree_audit.sh --strict",
    "git:cleanup": "bash scripts/git/worktree_cleanup_sweep.sh",
    "backend:start": "tsx src/server/agentSystemBackend.ts",
    "dev:standalone": "bash scripts/infra/start_all.sh --standalone",
    "infra:start": "bash scripts/infra/start_all.sh",
    "infra:restart": "bash scripts/infra/start_all.sh --restart",
    "db:migrate:postgres": "bash scripts/db/migrate_postgres.sh",
    "infra:start:profile": "bash scripts/infra/start_with_profile.sh",
    "infra:compose:up": "bash scripts/infra/container_compose_up.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myasnikoviv/Agents-system.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/myasnikoviv/Agents-system/issues"
  },
  "homepage": "https://github.com/myasnikoviv/Agents-system#readme",
  "dependencies": {
    "@langchain/anthropic": "^1.3.25",
    "@langchain/core": "^1.1.36",
    "@langchain/langgraph": "^1.2.5",
    "@langchain/openai": "^1.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "@types/uuid": "^10.0.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.13.6",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "openai": "^6.32.0",
    "pg": "^8.13.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.1.16",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1"
  }
}
