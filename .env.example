# Environment Configuration Example
# Copy to .env and fill in the values

# LangGraph & LangSmith
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGSMITH_PROJECT="Agent system"
LANGSMITH_API_KEY=

# OpenAI (required for agents and transcription)
OPENAI_API_KEY=

# Plane Task Management
# Obtain from http://localhost:3000/profile/api-keys
PLANE_API_KEY=
PLANE_BASE_URL=http://localhost:3000
PLANE_WORKSPACE=agent-system
PLANE_PROJECT_ID=605caec0-10f7-44f1-be01-172d381eb2e7

# Infrastructure
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://localhost:5432/agent_system

# Auth (Sprint 26 foundation)
# AUTH_MODE: optional | required
AUTH_MODE=optional
AUTH_SESSION_TTL_HOURS=24

# Frontend split (Sprint 35.5B)
CLIENT_URL=http://127.0.0.1:3000
ADMIN_URL=http://127.0.0.1:3001
VITE_API_URL=http://127.0.0.1:13001
